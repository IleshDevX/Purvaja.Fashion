# ==============================================================================
# Purvaja Fashion Atelier — Frontend Environment Variables Contract
# ==============================================================================
# SECURITY WARNING:
# Any variable prefixed with VITE_ is bundled into client-side JavaScript and
# is publicly visible to anyone inspecting the website in a browser.
# NEVER expose database credentials, session secrets, Resend API keys, or
# payment private keys in this file.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. API BASE URL
# ------------------------------------------------------------------------------
# Recommended Architecture (Hostinger VPS / Single Domain Reverse Proxy):
# Set VITE_API_URL=/api/v1
# This ensures all API requests are sent to the same domain (e.g. https://purvaja.fashion/api/v1),
# eliminating CORS preflights, cross-site cookie restrictions, and browser third-party cookie blocking.
#
# Alternative Architecture (Dedicated API Subdomain):
# Set VITE_API_URL=https://api.purvaja.fashion/api/v1
# If using this approach, ensure CORS_ORIGIN and COOKIE_DOMAIN are configured on the backend.
VITE_API_URL=http://localhost:5001/api/v1

# Application branding title
VITE_APP_NAME=Purvaja Fashion - Atelier

# ------------------------------------------------------------------------------
# 2. OPTIONAL CLIENT TELEMETRY & ERROR REPORTING
# ------------------------------------------------------------------------------
# Optional HTTPS endpoint for receiving client-side JavaScript errors (e.g. Sentry tunnel or custom logger)
VITE_ERROR_REPORTING_URL=


# ==============================================================================
# ENVIRONMENT PROFILES & REFERENCE CONFIGURATIONS
# ==============================================================================

# ------------------------------------------------------------------------------
# PROFILE A: LOCAL DEVELOPMENT (.env.development)
# ------------------------------------------------------------------------------
# VITE_API_URL=http://localhost:5001/api/v1
# VITE_APP_NAME=Purvaja Fashion - Atelier (Dev)
# VITE_ERROR_REPORTING_URL=

# ------------------------------------------------------------------------------
# PROFILE B: STAGING ENVIRONMENT (.env.staging)
# ------------------------------------------------------------------------------
# Option 1 (Single-domain proxy behind Nginx):
# VITE_API_URL=/api/v1
# Option 2 (Subdomain):
# VITE_API_URL=https://staging-api.purvaja.fashion/api/v1
# VITE_APP_NAME=Purvaja Fashion - Atelier (Staging)

# ------------------------------------------------------------------------------
# PROFILE C: HOSTINGER PRODUCTION (.env.production)
# ------------------------------------------------------------------------------
# Recommended (Single-domain Nginx reverse proxy):
# VITE_API_URL=/api/v1
#
# Subdomain alternative:
# VITE_API_URL=https://api.purvaja.fashion/api/v1
# VITE_APP_NAME=Purvaja Fashion - Atelier
# VITE_ERROR_REPORTING_URL=
