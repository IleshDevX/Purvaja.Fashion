# ==============================================================================
# Purvaja Fashion Atelier — Backend Environment Contract & Configuration
# ==============================================================================
# IMPORTANT:
# - NEVER commit real secrets (passwords, private keys, API tokens) to git.
# - In production (NODE_ENV=production), the backend runs strict startup checks
#   and will abort if required variables are missing or insecure (e.g. sslmode=no-verify).
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION RUNTIME (HOSTINGER / NODE.JS)
# ------------------------------------------------------------------------------
# Application environment mode: 'development', 'staging', or 'production'
NODE_ENV=development

# Application port. In Hostinger Web Hosting, PORT may be provided by Passenger.
# On Hostinger VPS, standard port is 5001 (or 3000).
PORT=5001

# Application listen host:
# - '0.0.0.0': Listens on all interfaces (Hostinger VPS / containerized / Node runtime)
# - '127.0.0.1': Listens on loopback only (when reverse-proxied locally by Nginx/LiteSpeed)
HOST=0.0.0.0

# Express Trust Proxy:
# - 'loopback': Trust local loopback (127.0.0.1, ::1). Safe default for VPS behind local Nginx.
# - '1': Trust 1 proxy hop (standard when deployed behind Cloudflare, Hostinger Edge, or reverse proxy).
# - 'false': Do not trust proxies (direct exposure only - not recommended for production).
TRUST_PROXY=loopback

# Cookie Domain (Optional):
# - Leave blank: Host-only cookies (recommended when frontend & API share root domain or Nginx proxy).
# - '.yourdomain.com': Set with leading dot if frontend and API run on separate subdomains (e.g. app.domain.com and api.domain.com).
COOKIE_DOMAIN=

# ------------------------------------------------------------------------------
# 2. CLIENT & CORS CONFIGURATION
# ------------------------------------------------------------------------------
# Comma-separated list of allowed frontend origins for CORS with credentials.
# Wildcard '*' is strictly forbidden and rejected when credentials are enabled.
CORS_ORIGIN=http://localhost:5174

# Canonical customer-facing frontend URL (used in email verification & password reset links).
# In production, must be an HTTPS URL without trailing slash.
FRONTEND_URL=http://localhost:5174

# ------------------------------------------------------------------------------
# 3. POSTGRESQL DATABASE CONFIGURATION
# ------------------------------------------------------------------------------
# Production PostgreSQL connection URL with connection pooling.
# In production, must use SSL/TLS (sslmode=require or verify-full).
# Note: 'sslmode=no-verify' is strictly rejected in staging and production.
DATABASE_URL=postgresql://user:password@hostname:5432/purvaja_db?schema=public&sslmode=require

# Direct PostgreSQL connection URL for running Prisma CLI migrations (bypasses transaction pooler).
DIRECT_URL=postgresql://user:password@hostname:5432/purvaja_db?schema=public&sslmode=require

# ------------------------------------------------------------------------------
# 5. TRANSACTIONAL EMAIL (RESEND)
# ------------------------------------------------------------------------------
# Resend API key (starts with 're_'). Authentication email configuration is
# mandatory in staging/production. Development can omit it; registration then
# reports emailSent=false and recovery requests remain generic and non-delivering.
RESEND_API_KEY=

# Verified sender email address (plain RFC 5322 address format).
EMAIL_FROM=noreply@purvaja.fashion

# ------------------------------------------------------------------------------
# 6. CACHE & PERFORMANCE (REDIS — OPTIONAL)
# ------------------------------------------------------------------------------
# Redis connection URL (e.g. redis://127.0.0.1:6379 or rediss://... for TLS).
# Catalogue caching is optional. When omitted or unavailable, the application
# falls back to direct PostgreSQL queries without interruption.
# Sessions are ALWAYS stored in PostgreSQL, never Redis.
REDIS_URL=

# Shared abuse-prevention quotas are operational state, separate from catalogue
# caching. This is required in staging and production, including a single-process
# deployment, so adding another process or replica cannot silently reset quotas.
RATE_LIMIT_REDIS_URL=
OPERATIONAL_ALERT_WEBHOOK_URL=
OPERATIONAL_ALERT_WEBHOOK_TOKEN=

# Mutating smoke tests use an explicit target contract. Only disposable staging
# data is permitted. The runner rejects production regardless of hostname.
SMOKE_TARGET_ENV=local
SMOKE_BASE_URL=
SMOKE_ALLOW_MUTATIONS=false

# Backup and recovery drills. The restore command refuses the source database,
# requires a checksum manifest, and writes measured recovery evidence.
BACKUP_DIRECTORY=backups
BACKUP_MANIFEST_FILE=
RECOVERY_DATABASE_URL=
RECOVERY_TARGET_ENV=
RECOVERY_CONFIRM_REPLACE=
RECOVERY_REPORT_FILE=

# ------------------------------------------------------------------------------
# 7. PAYMENT ARCHITECTURE (UPI ONLY — PHONEPE)
# ------------------------------------------------------------------------------
# Active payment provider: 'demo' or 'phonepe'.
# CRITICAL: 'demo' is rejected if NODE_ENV=production. Real PhonePe credentials
# remain unset until a merchant account and confirmed provider contract exist.
PAYMENT_PROVIDER=demo

# Required when PAYMENT_PROVIDER=phonepe:
PHONEPE_MERCHANT_ID=
PHONEPE_CLIENT_ID=
PHONEPE_CLIENT_SECRET=
PHONEPE_CLIENT_VERSION=
PHONEPE_ENVIRONMENT=sandbox
PHONEPE_CALLBACK_URL=
PHONEPE_WEBHOOK_USERNAME=
PHONEPE_WEBHOOK_PASSWORD=


# ==============================================================================
# ENVIRONMENT PROFILES & REFERENCE CONFIGURATIONS
# ==============================================================================

# ------------------------------------------------------------------------------
# PROFILE A: LOCAL DEVELOPMENT (.env.development)
# ------------------------------------------------------------------------------
# NODE_ENV=development
# PORT=5001
# HOST=0.0.0.0
# TRUST_PROXY=loopback
# CORS_ORIGIN=http://localhost:5174
# FRONTEND_URL=http://localhost:5174
# COOKIE_DOMAIN=
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/purvaja_dev?schema=public
# DIRECT_URL=postgresql://postgres:postgres@localhost:5432/purvaja_dev?schema=public
# RESEND_API_KEY=
# EMAIL_FROM=noreply@purvaja.fashion
# REDIS_URL=
# PAYMENT_PROVIDER=demo

# ------------------------------------------------------------------------------
# PROFILE B: STAGING ENVIRONMENT (.env.staging)
# ------------------------------------------------------------------------------
# NODE_ENV=staging
# PORT=5001
# HOST=127.0.0.1
# TRUST_PROXY=1
# CORS_ORIGIN=https://staging.purvaja.fashion
# FRONTEND_URL=https://staging.purvaja.fashion
# COOKIE_DOMAIN=
# DATABASE_URL=postgresql://staging_user:StagingPass123!@db.hostinger.internal:5432/purvaja_staging?schema=public&sslmode=require
# DIRECT_URL=postgresql://staging_user:StagingPass123!@db.hostinger.internal:5432/purvaja_staging?schema=public&sslmode=require
# RESEND_API_KEY=re_staging_test_key_here
# EMAIL_FROM=noreply@staging.purvaja.fashion
# REDIS_URL=redis://127.0.0.1:6379
# PAYMENT_PROVIDER=demo

# ------------------------------------------------------------------------------
# PROFILE C: HOSTINGER PRODUCTION (.env.production)
# ------------------------------------------------------------------------------
# NODE_ENV=production
# PORT=5001
# HOST=127.0.0.1
# TRUST_PROXY=1
# CORS_ORIGIN=https://purvaja.fashion,https://www.purvaja.fashion
# FRONTEND_URL=https://purvaja.fashion
# COOKIE_DOMAIN=
# DATABASE_URL=postgresql://prod_user:StrongPasswordHere@prod-db.hostinger.internal:5432/purvaja_prod?schema=public&sslmode=require
# DIRECT_URL=postgresql://prod_user:StrongPasswordHere@prod-db.hostinger.internal:5432/purvaja_prod?schema=public&sslmode=require
# RESEND_API_KEY=re_live_production_key_here
# EMAIL_FROM=noreply@purvaja.fashion
# REDIS_URL=redis://127.0.0.1:6379
# PAYMENT_PROVIDER=demo

# Shared authentication/request quotas, separate from optional catalogue caching.
# Required in staging and production. All processes/replicas must use the same store.
WEB_CONCURRENCY=1
# RATE_LIMIT_REDIS_URL=redis://127.0.0.1:6379/1
