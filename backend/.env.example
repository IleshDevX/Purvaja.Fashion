# Application
NODE_ENV=development
PORT=5001

# Client
CORS_ORIGIN=http://localhost:5174

# PostgreSQL / Supabase (server-side only; use an SSL-enabled connection string)
# Session pooler (Port 5432) or transaction pooler (Port 6543)
DATABASE_URL=
# Session pooler / direct connection used for Prisma migrations (Port 5432)
DIRECT_URL=

# Session authentication
SESSION_SECRET=

# Transactional email (backend only)
RESEND_API_KEY=
EMAIL_FROM=
FRONTEND_URL=http://localhost:5174

# Redis
REDIS_URL=

# Payment - PhonePe
PAYMENT_PROVIDER=demo
PHONEPE_MERCHANT_ID=
PHONEPE_CLIENT_ID=
PHONEPE_CLIENT_SECRET=
PHONEPE_CLIENT_VERSION=
PHONEPE_ENVIRONMENT=sandbox
PHONEPE_CALLBACK_URL=
