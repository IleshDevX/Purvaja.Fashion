generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  CUSTOMER
  ADMIN
}
enum AccountStatus {
  ACTIVE
  SUSPENDED
  DISABLED
}
enum EmailVerificationPurpose {
  REGISTRATION
  EMAIL_CHANGE
}
enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}
enum VariantStatus {
  ACTIVE
  DISCONTINUED
}
enum InventoryMovementType {
  INITIAL
  RESTOCK
  ADJUSTMENT
  DAMAGE
  CORRECTION
  SALE
  RETURN
  CANCELLATION
}
enum ReviewStatus {
  PENDING
  PUBLISHED
  REJECTED
}
enum CartStatus {
  ACTIVE
  ABANDONED
  CONVERTED
}
enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  RETURN_REQUESTED
  RETURNED
}
enum PaymentStatus {
  PENDING
  INITIATED
  AUTHORIZED
  PAID
  SUCCESS
  FAILED
  EXPIRED
  REFUNDED
  CANCELLED
}
enum PaymentProvider {
  COD
  PHONEPE
}
enum PaymentMethod {
  CASH_ON_DELIVERY
  UPI
}
enum InventoryReservationStatus {
  ACTIVE
  CONSUMED
  RELEASED
  EXPIRED
}
enum CouponDiscountType {
  PERCENTAGE
  FIXED
}

model User {
  id                      String                   @id @default(uuid()) @db.Uuid
  email                   String                   @unique @db.VarChar(320)
  passwordHash            String                   @map("password_hash") @db.VarChar(255)
  firstName               String                   @default("") @map("first_name") @db.VarChar(100)
  lastName                String                   @default("") @map("last_name") @db.VarChar(100)
  phone                   String?                  @db.VarChar(32)
  pendingEmail            String?                  @map("pending_email") @db.VarChar(320)
  role                    UserRole                 @default(CUSTOMER)
  status                  AccountStatus            @default(ACTIVE)
  emailVerifiedAt         DateTime?                @map("email_verified_at") @db.Timestamptz(6)
  createdAt               DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt               DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(6)
  addresses               Address[]
  auditLogs               AuditLog[]
  carts                   Cart[]
  couponRedemptions       CouponRedemption[]
  emailVerificationTokens EmailVerificationToken[]
  orders                  Order[]
  passwordResetTokens     PasswordResetToken[]
  reviews                 Review[]
  sessions                Session[]

  @@index([role, status])
  @@map("users")
}

model Session {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.Char(64)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  user      User      @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, expiresAt])
  @@index([expiresAt])
  @@map("sessions")
}

model EmailVerificationToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.Char(64)
  purpose   EmailVerificationPurpose @default(REGISTRATION)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([expiresAt])
  @@map("email_verification_tokens")
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.Char(64)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

model Address {
  id            String   @id @default(uuid()) @db.Uuid
  userId        String   @map("user_id") @db.Uuid
  recipientName String   @map("recipient_name") @db.VarChar(160)
  phone         String   @db.VarChar(32)
  line1         String   @db.VarChar(255)
  line2         String?  @db.VarChar(255)
  city          String   @db.VarChar(120)
  state         String   @db.VarChar(120)
  postalCode    String   @map("postal_code") @db.VarChar(32)
  country       String   @default("IN") @db.Char(2)
  isDefault     Boolean  @default(false) @map("is_default")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  user          User     @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@map("addresses")
}

model Category {
  id          String            @id @default(uuid()) @db.Uuid
  name        String            @db.VarChar(120)
  slug        String            @unique @db.VarChar(160)
  description String?           @db.Text
  isActive    Boolean           @default(true) @map("is_active")
  createdAt   DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)
  products    ProductCategory[]

  @@map("categories")
}

model Product {
  id                  String            @id @default(uuid()) @db.Uuid
  name                String            @db.VarChar(255)
  slug                String            @unique @db.VarChar(255)
  tagline             String?           @db.VarChar(500)
  description         String            @db.Text
  brand               String            @default("Purvaja") @db.VarChar(120)
  basePricePaise      Int               @map("base_price_paise")
  compareAtPricePaise Int?              @map("compare_at_price_paise")
  discountPercent     Int?              @map("discount_percent") @db.SmallInt
  status              ProductStatus     @default(DRAFT)
  fit                 String?           @db.VarChar(80)
  fabric              String?           @db.VarChar(120)
  collar              String?           @db.VarChar(120)
  sleeve              String?           @db.VarChar(80)
  pattern             String?           @db.VarChar(80)
  careInstructions    String[]          @default([]) @map("care_instructions")
  rating              Decimal           @default(0) @db.Decimal(2, 1)
  reviewCount         Int               @default(0) @map("review_count")
  isFeatured          Boolean           @default(false) @map("is_featured")
  isNewArrival        Boolean           @default(false) @map("is_new_arrival")
  isDeal              Boolean           @default(false) @map("is_deal")
  metadata            Json?
  createdAt           DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)
  categories          ProductCategory[]
  images              ProductImage[]
  reviews             Review[]
  variants            ProductVariant[]

  @@index([status, createdAt])
  @@index([isFeatured, status])
  @@index([isNewArrival, status])
  @@map("products")
}

model ProductImage {
  id        String   @id @default(uuid()) @db.Uuid
  productId String   @map("product_id") @db.Uuid
  url       String   @db.Text
  sortOrder Int      @map("sort_order")
  isPrimary Boolean  @default(false) @map("is_primary")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, sortOrder])
  @@index([productId, isPrimary])
  @@map("product_images")
}

model ProductVariant {
  id                 String             @id @default(uuid()) @db.Uuid
  productId          String             @map("product_id") @db.Uuid
  sku                String             @unique @db.VarChar(160)
  size               String             @db.VarChar(80)
  colorName          String             @map("color_name") @db.VarChar(120)
  colorHex           String             @map("color_hex") @db.Char(7)
  priceOverridePaise Int?               @map("price_override_paise")
  stockQuantity      Int                @default(0) @map("stock_quantity")
  lowStockThreshold  Int                @default(10) @map("low_stock_threshold")
  status             VariantStatus      @default(ACTIVE)
  createdAt          DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)
  cartItems          CartItem[]
  inventoryMovements InventoryMovement[]
  inventoryReservations InventoryReservation[]
  orderItems         OrderItem[]
  product            Product            @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([productId, colorName, size])
  @@index([productId])
  @@index([status])
  @@index([stockQuantity], map: "product_variants_stock_quantity_idx")
  @@map("product_variants")
}

model ProductCategory {
  productId  String   @map("product_id") @db.Uuid
  categoryId String   @map("category_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  product    Product  @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@id([productId, categoryId])
  @@index([categoryId])
  @@map("product_categories")
}

model InventoryMovement {
  id                String                @id @default(uuid()) @db.Uuid
  variantId         String                @map("variant_id") @db.Uuid
  type              InventoryMovementType
  quantity          Int
  previousQuantity  Int                   @map("previous_quantity")
  resultingQuantity Int                   @map("resulting_quantity")
  reason            String?               @db.VarChar(500)
  referenceType     String?               @map("reference_type") @db.VarChar(80)
  referenceId       String?               @map("reference_id") @db.Uuid
  createdAt         DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  variant           ProductVariant        @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@index([variantId, createdAt])
  @@map("inventory_movements")
}

model Review {
  id        String       @id @default(uuid()) @db.Uuid
  userId    String       @map("user_id") @db.Uuid
  productId String       @map("product_id") @db.Uuid
  rating    Int          @db.SmallInt
  title     String?      @db.VarChar(200)
  content   String       @db.Text
  status    ReviewStatus @default(PENDING)
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  product   Product      @relation(fields: [productId], references: [id], onDelete: Restrict)
  user      User         @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([userId, productId])
  @@index([productId, status, createdAt])
  @@index([userId])
  @@map("reviews")
}

model Cart {
  id        String     @id @default(uuid()) @db.Uuid
  userId    String     @unique @map("user_id") @db.Uuid
  status    CartStatus @default(ACTIVE)
  createdAt DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)
  items     CartItem[]
  user      User       @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([status])
  @@map("carts")
}

model CartItem {
  id        String         @id @default(uuid()) @db.Uuid
  cartId    String         @map("cart_id") @db.Uuid
  variantId String         @map("variant_id") @db.Uuid
  quantity  Int
  createdAt DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)
  cart      Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@unique([cartId, variantId])
  @@index([cartId])
  @@map("cart_items")
}

model Order {
  id                  String        @id @default(uuid()) @db.Uuid
  orderNumber         String        @unique @map("order_number") @db.VarChar(64)
  userId              String        @map("user_id") @db.Uuid
  shippingAddress     Json          @map("shipping_address")
  billingAddress      Json?         @map("billing_address")
  subtotalPaise       Int           @map("subtotal_paise")
  discountPaise       Int           @default(0) @map("discount_paise")
  shippingChargePaise Int           @default(0) @map("shipping_charge_paise")
  taxPaise            Int           @default(0) @map("tax_paise")
  totalPaise          Int           @map("total_paise")
  status              OrderStatus   @default(PENDING)
  paymentStatus       PaymentStatus @default(PENDING) @map("payment_status")
  createdAt           DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)
  couponRedemptions   CouponRedemption[]
  items               OrderItem[]
  payments            Payment[]
  inventoryReservations InventoryReservation[]
  user                User          @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@index([paymentStatus])
  @@map("orders")
}

model OrderItem {
  id             String          @id @default(uuid()) @db.Uuid
  orderId        String          @map("order_id") @db.Uuid
  variantId      String?         @map("variant_id") @db.Uuid
  productName    String          @map("product_name") @db.VarChar(255)
  sku            String          @db.VarChar(160)
  size           String          @db.VarChar(80)
  colorName      String          @map("color_name") @db.VarChar(120)
  unitPricePaise Int             @map("unit_price_paise")
  quantity       Int
  lineTotalPaise Int             @map("line_total_paise")
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  order          Order           @relation(fields: [orderId], references: [id], onDelete: Restrict)
  variant        ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@map("order_items")
}

model Payment {
  id                String          @id @default(uuid()) @db.Uuid
  orderId           String          @map("order_id") @db.Uuid
  provider          PaymentProvider
  method            PaymentMethod
  amountPaise       Int             @map("amount_paise")
  status            PaymentStatus   @default(PENDING)
  providerReference String?         @unique @map("provider_reference") @db.VarChar(255)
  idempotencyKey    String          @unique @map("idempotency_key") @db.Uuid
  expiresAt         DateTime?       @map("expires_at") @db.Timestamptz(6)
  createdAt         DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)
  order             Order           @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@map("payments")
}

model InventoryReservation {
  id          String                     @id @default(uuid()) @db.Uuid
  orderId     String                     @map("order_id") @db.Uuid
  variantId   String                     @map("variant_id") @db.Uuid
  quantity    Int
  status      InventoryReservationStatus @default(ACTIVE)
  expiresAt   DateTime                   @map("expires_at") @db.Timestamptz(6)
  releasedAt  DateTime?                  @map("released_at") @db.Timestamptz(6)
  createdAt   DateTime                   @default(now()) @map("created_at") @db.Timestamptz(6)
  order       Order                      @relation(fields: [orderId], references: [id], onDelete: Restrict)
  variant     ProductVariant             @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@unique([orderId, variantId])
  @@index([status, expiresAt])
  @@index([variantId, status])
  @@map("inventory_reservations")
}

model Coupon {
  id                  String             @id @default(uuid()) @db.Uuid
  code                String             @unique @db.VarChar(80)
  discountType        CouponDiscountType @map("discount_type")
  discountValue       Int                @map("discount_value")
  minimumOrderPaise   Int?               @map("minimum_order_paise")
  maximumDiscountPaise Int?              @map("maximum_discount_paise")
  usageLimit          Int?               @map("usage_limit")
  startsAt            DateTime?          @map("starts_at") @db.Timestamptz(6)
  endsAt              DateTime?          @map("ends_at") @db.Timestamptz(6)
  isActive            Boolean            @default(true) @map("is_active")
  createdAt           DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)
  redemptions         CouponRedemption[]

  @@index([isActive, startsAt, endsAt])
  @@map("coupons")
}

model CouponRedemption {
  id         String   @id @default(uuid()) @db.Uuid
  couponId   String   @map("coupon_id") @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  orderId    String   @map("order_id") @db.Uuid
  redeemedAt DateTime @default(now()) @map("redeemed_at") @db.Timestamptz(6)
  coupon     Coupon   @relation(fields: [couponId], references: [id], onDelete: Restrict)
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Restrict)
  user       User     @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([couponId, orderId])
  @@index([userId, couponId])
  @@map("coupon_redemptions")
}

model AuditLog {
  id         String    @id @default(uuid()) @db.Uuid
  actorId    String?   @map("actor_id") @db.Uuid
  action     String    @db.VarChar(160)
  entityType String    @map("entity_type") @db.VarChar(120)
  entityId   String?   @map("entity_id") @db.Uuid
  metadata   Json?
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  actor      User?     @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId, createdAt])
  @@index([actorId, createdAt])
  @@map("audit_logs")
}
